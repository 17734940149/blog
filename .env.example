# 本地运行使用 http://localhost:3000；生产必须改为实际 https 站点地址。
APP_URL=http://localhost:3000
# 本地开发标识。Compose 会固定设置 production。
ENVIRONMENT=development
# 仅用于本地 Next 服务读取 Python API；Compose 会固定改为 http://api:8000。
API_INTERNAL_URL=http://127.0.0.1:8000
# 复制到 backend/.env 后，Python 相对 backend 目录写入；Compose 固定使用命名卷。
DATA_DIR=./data
# 演示内容由首次空库初始化创建。正式站点设 false 后再初始化。
DEMO_SEED=true
# 以下配置仅用于 compose.production.yaml；域名不带协议、路径或端口。
DOMAIN=
ACME_EMAIL=
# 填写备案通过通知中的完整网站备案号，留空时页脚不显示。
ICP_FILING_NUMBER=
# 每次上线指定唯一版本，例如 v1.0.0；留空时采用 local。
IMAGE_TAG=local
# Docker 数据卷名。恢复备份时使用新卷名，保留原卷以便回退。
DATA_VOLUME=stacknote-data
